{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "field-sop",
  "version": "0.1.0",
  "identifier": "ca.uvic.field-sop",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "field-sop",
        "width": 1560,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Science",
    "shortDescription": "Field procedures and checklist records for geomagnetic survey work",
    "longDescription": "Runs a checklist step by step, records what happened, and edits the Markdown content that the procedures are written in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "librsvg2-2"
        ]
      }
    }
  }
}
