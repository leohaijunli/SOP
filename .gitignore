__pycache__/
*.pyc
.venv/
dist/manifest.json
/target
node_modules/

# Atomic-write siblings (a crash can leave one behind).
*.tmp

# Workspace metadata (log remarks/tags are included in full workspace exports).
.field-sop/
**/.record.lock

# Project + settings written by the Confirm button on the Project/Settings pages.
configure.json

# Records the app exports on demand. The record itself is committed under runs/.
exports/
